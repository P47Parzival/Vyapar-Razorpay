{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://YOUR_RENDER_URL.onrender.com/api/:path*" },
    { "source": "/health", "destination": "https://YOUR_RENDER_URL.onrender.com/health" },
    { "source": "/.well-known/:path*", "destination": "https://YOUR_RENDER_URL.onrender.com/.well-known/:path*" }
  ]
}
